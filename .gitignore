# ===== CMake 生成物 =====
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
CMakeUserPresets.json          # 用户本地 preset，非团队共享
compile_commands.json          # clangd/IDE 用，本地生成
_deps/                         # FetchContent 拉下来的依赖
Testing/                       # ctest 输出

# ===== 常见构建目录（out-of-source build）=====
build/
build-*/
out/
cmake-build-*/                 # CLion 默认目录：cmake-build-debug 等

# ===== 编译产物 =====
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.exp
*.pdb
*.ilk

# ===== IDE / 编辑器 =====
.vscode/
.idea/
.cache/                        # clangd 缓存

# ===== 本地 Agent / Codex 状态 =====
/.agents/
/.codex/
/skills-lock.json

# ===== 性能分析输出 =====
*.pt.trace.json
*.csv
*.png
*.ncu-rep
